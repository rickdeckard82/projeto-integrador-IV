# Copiar para /etc/oficios-rpz/backup.env (dono root, chmod 600). Ver README > Backup automático.

BACKUP_DIR=/var/backups/oficios-rpz
# Chave age (age-keygen). Guardar uma cópia fora do servidor: sem ela os backups são irrecuperáveis.
BACKUP_AGE_IDENTITY=/etc/oficios-rpz/backup-age.key
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Horário do último sucesso (epoch), para monitoramento
BACKUP_STATUS_DIR=/var/lib/oficios-rpz-backup

# Destino remoto (obrigatório). Duas formas:
# - rsync daemon: "host::modulo/pasta" ou "usuario@host::modulo/pasta" (senha em
#   BACKUP_RSYNC_PASSWORD_FILE, se o módulo tiver auth users). Ex.: 192.0.2.10::backup/oficios-rpz
# - ssh: "usuario@host:" (com rrsync no destino, o caminho é relativo à pasta liberada).
BACKUP_REMOTE_TARGET=192.0.2.10::backup/oficios-rpz
BACKUP_RSYNC_PASSWORD_FILE=
# Só para destino via ssh
BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_SSH_KEY=/etc/oficios-rpz/backup_ssh_key
BACKUP_REMOTE_KNOWN_HOSTS=/etc/oficios-rpz/backup_known_hosts
