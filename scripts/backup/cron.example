# Copiar para /etc/cron.d/oficios-rpz-backup
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Backup diário às 02:30
30 2 * * * root /app/oficios-rpz/scripts/backup/backup.sh >> /var/log/oficios-rpz-backup.log 2>&1
# Teste de restauração aos domingos às 04:30
30 4 * * 0 root /app/oficios-rpz/scripts/backup/restore-test.sh >> /var/log/oficios-rpz-backup.log 2>&1
