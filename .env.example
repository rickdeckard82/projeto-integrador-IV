# Aplicacao
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
SESSION_LIFETIME_MINUTES=60
PUBLISH_LOCK_TIMEOUT_MINUTES=30
GUNICORN_TIMEOUT=300
UPLOAD_FOLDER=/app/uploads
MAX_UPLOAD_MB=50

# Caminhos fixos no host para volumes em producao
HOST_UPLOAD_PATH=/app/oficios-rpz/upload
HOST_SSH_KEY_PATH=/app/oficios-rpz/ssh/id_rsa
# Chaves de host do BIND e dos roteadores (gerar com ssh-keyscan -p <porta> <host>)
HOST_SSH_KNOWN_HOSTS_PATH=/app/oficios-rpz/ssh/known_hosts

# Rede compartilhada com o Nginx Proxy Manager
NPM_NETWORK_NAME=proxy
# Alias do frontend (SPA React) - aponte o proxy host do NPM para cá
NPM_FRONTEND_ALIAS=oficios-frontend

# Usuario administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# API (autenticacao via header X-API-Key). Vazio = API desabilitada.
API_KEY=

# Banco de dados MySQL
MYSQL_DATABASE=oficios_rpz
MYSQL_USER=oficios_rpz
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-root-forte

# Timeouts e conexao com o banco
DB_CONNECT_ATTEMPTS=30
DB_CONNECT_DELAY_SECONDS=2
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=20
DB_WRITE_TIMEOUT_SECONDS=20
DB_POOL_RECYCLE_SECONDS=1800
DB_BACKUP_TIMEOUT_SECONDS=300
# Backup automático por FTP (container backup-worker). Servidor, horário e retenção
# são configurados em Geral > Backup; aqui só o fuso do horário e a frequência de checagem.
BACKUP_TIMEZONE=America/Sao_Paulo
BACKUP_WORKER_INTERVAL_SECONDS=30

# Servidores BIND, roteadores e credenciais SSH sao cadastrados em Geral > Parametros.
# Aqui ficam so os arquivos montados no container: a chave privada (informe
# /run/secrets/bind_ssh_key como caminho da chave em Parametros) e o known_hosts
# (gerar com ssh-keyscan -p <porta> <host>), definidos acima em HOST_SSH_KEY_PATH e
# HOST_SSH_KNOWN_HOSTS_PATH.

# WHOIS/RDAP de IPs
WHOIS_LOOKUP_TIMEOUT_SECONDS=8
WHOIS_WORKER_INTERVAL_SECONDS=5
WHOIS_WORKER_MAX_ATTEMPTS=3

# Notificações de abuse (coleta IMAPS somente leitura). Servidor, usuário, senha e caixa
# ficam em Geral > Parâmetros (seção "Coleta de abuse (IMAP)"); sem servidor, a coleta fica desativada.
# CA própria do servidor IMAP (caminho dentro do container), se não for pública.
ABUSE_IMAP_CA_FILE=
ABUSE_IMAP_TIMEOUT_SECONDS=60
ABUSE_POLL_INTERVAL_SECONDS=600
ABUSE_MAX_MESSAGE_MB=25
# Origem do login PPPoE por IP privado; por enquanto só "manual".
ABUSE_SESSION_RESOLVER=manual
